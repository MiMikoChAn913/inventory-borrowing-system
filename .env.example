# Copy this file to .env for local development. Never commit .env.
DATABASE_URL=postgresql://inventory_user:change-locally@localhost:5432/inventory_db?schema=public
PORT=3000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
SESSION_TTL_HOURS=8

# Required only when running the seed command.
SEED_BORROWER_EMAIL=borrower@example.test
SEED_BORROWER_PASSWORD=replace-with-a-local-password
SEED_CUSTODIAN_EMAIL=custodian@example.test
SEED_CUSTODIAN_PASSWORD=replace-with-a-local-password
